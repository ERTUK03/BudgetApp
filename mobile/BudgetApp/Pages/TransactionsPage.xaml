<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BudgetApp.Pages.TransactionsPage"
             Title="Transakcje"
             BackgroundColor="#080c14">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Filter bar -->
    <Frame Grid.Row="0" BackgroundColor="#0f1623" BorderColor="#1e2d45" CornerRadius="0" Padding="12,10">
      <HorizontalStackLayout Spacing="8">
        <Picker x:Name="TypeFilter" TextColor="#e2eaf4" BackgroundColor="#161e2e"
                SelectedIndexChanged="OnFilterChanged" WidthRequest="130"/>
        <Picker x:Name="MonthFilter" TextColor="#e2eaf4" BackgroundColor="#161e2e"
                SelectedIndexChanged="OnFilterChanged" WidthRequest="110"/>
      </HorizontalStackLayout>
    </Frame>

    <!-- List -->
    <RefreshView x:Name="Refresh" Grid.Row="1" Refreshing="OnRefresh">
      <CollectionView x:Name="TxList" Margin="12,8">
        <CollectionView.EmptyView>
          <Label Text="Brak transakcji w wybranym okresie" TextColor="#7a92b0"
                 HorizontalOptions="Center" VerticalOptions="Center" Margin="0,40"/>
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <SwipeView>
              <SwipeView.RightItems>
                <SwipeItems>
                  <SwipeItem Text="Usuń" BackgroundColor="#7f1d1d" IconImageSource="delete.png"
                             Invoked="OnDelete" CommandParameter="{Binding Id}"/>
                </SwipeItems>
              </SwipeView.RightItems>
              <Frame BackgroundColor="#0f1623" BorderColor="#1e2d45" CornerRadius="10"
                     Padding="14,10" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                  <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding Title}" FontSize="15" TextColor="#e2eaf4" FontAttributes="Bold"/>
                    <Label Text="{Binding CategoryDisplay}" FontSize="12" TextColor="#7a92b0"/>
                  </VerticalStackLayout>
                  <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="2">
                    <Label Text="{Binding AmountDisplay}" FontSize="15" FontAttributes="Bold"
                           TextColor="{Binding AmountColor}" HorizontalOptions="End"/>
                    <Label Text="{Binding DateDisplay}" FontSize="11" TextColor="#7a92b0" HorizontalOptions="End"/>
                  </VerticalStackLayout>
                </Grid>
              </Frame>
            </SwipeView>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </RefreshView>

    <!-- Add button -->
    <Button Grid.Row="2" Text="➕ Nowa transakcja" Clicked="OnAdd"
            BackgroundColor="#3b82f6" TextColor="White" CornerRadius="0"
            FontAttributes="Bold" HeightRequest="56" Margin="0"/>

  </Grid>
</ContentPage>
